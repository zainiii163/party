# Neon PostgreSQL — use the pooled connection string for DATABASE_URL.
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/cousins?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/cousins?sslmode=require"

# Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Optional first-run organizer bootstrap. Change these immediately after first login.
ADMIN_EMAIL="organizer@example.com"
ADMIN_INITIAL_PASSWORD="a-strong-temporary-password"

# Vercel Blob (private store) for photos. Leave blank to show a setup-required state.
BLOB_READ_WRITE_TOKEN=""

# Full public URL, no trailing slash.
NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"
